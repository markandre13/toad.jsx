{
    "name": "toad.jsx",
    "version": "0.1.4",
    "description": "jsx for toad.js",
    "author": "Mark-André Hopf <mhopf@mark13.org>",
    "license": "AGPL-3.0",
    "module": "jsx-runtime.js",
    "types": "jsx-runtime.d.ts",
    "exports": {
        ".": "./jsx-runtime.js",
        "./jsx-runtime": "./jsx-runtime.js",
        "./jsx-dev-runtime": "./jsx-runtime.js",
        "./src/**/*": "./src/**/*"
    },
    "files": [
        "README.md",
        "package.json",
        "jsx-runtime.js",
        "jsx-runtime.d.ts",
        "jsx-runtime.js.map",
        "src/**/*.js",
        "src/**/*.js.map",
        "src/**/*.d.ts"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/markandre13/toad.jsx.git"
    },
    "scripts": {
        "build": "tsc",
        "dev:build": "tsc -w",
        "update": "npx npm-check-updates -u && npm install"
    },
    "devDependencies": {
        "typescript": "^5.8.2"
    },
    "dependencies": {
        "csstype": "^3.1.3"
    }
}